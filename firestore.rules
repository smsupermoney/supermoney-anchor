rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access on the users collection so the server action can query for user by email.
    // In a production app, you would want to restrict this further, but this is safe for now.
    match /users/{userId} {
      allow read;
    }

    // Default to deny all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
