
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read the users collection for login purposes
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can modify user data
    }
    
    // Allow authenticated users to access other collections
    match /{collection}/{id} where collection in ['invoices', 'dealers', 'programs'] {
      allow read, write: if request.auth != null;
    }
  }
}
