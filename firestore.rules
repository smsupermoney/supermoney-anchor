
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to the users collection for authentication
    match /users/{userId} {
      allow read: if true;
      allow write: if false; // Keep writes restricted for now
    }

    // Lock down all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
