rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read their own data, and the system can query for login
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Authenticated users can read and write dealers
    match /dealers/{dealerId} {
      allow read, write: if request.auth != null;
    }

    // Authenticated users can read and write invoices
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }

    // Authenticated users can read and write programs
    match /programs/{programId} {
      allow read, write: if request.auth != null;
    }
  }
}
