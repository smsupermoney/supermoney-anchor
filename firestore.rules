rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading users for authentication
    match /users/{userId} {
      allow read, list: if true;
    }

    // Allow reading programs and invoices for the dashboard and other pages
    match /programs/{programId} {
      allow read, list: if true;
    }
    match /invoices/{invoiceId} {
      allow read, list: if true;
    }
  }
}
